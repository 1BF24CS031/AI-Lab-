      "source": [
        "# Define the initial and goal states\n",
        "# Example solvable puzzle:\n",
        "initial_board = [\n",
        "    [1, 2, 3],\n",
        "    [4, 0, 5],\n",
        "    [6, 7, 8]\n",
        "]\n",
        "\n",
        "goal_board = [\n",
        "    [1, 2, 3],\n",
        "    [4, 5, 6],\n",
        "    [7, 8, 0]\n",
        "]\n",
        "\n",
        "# Example more complex solvable puzzle (might take longer):\n",
        "# initial_board = [\n",
        "#     [7, 2, 4],\n",
        "#     [5, 0, 6],\n",
        "#     [8, 3, 1]\n",
        "# ]\n",
        "# goal_board = [\n",
        "#     [0, 1, 2],\n",
        "#     [3, 4, 5],\n",
        "#     [6, 7, 8]\n",
        "# ]\n",
        "\n",
        "initial_state = PuzzleState(initial_board)\n",
        "goal_state = PuzzleState(goal_board)\n",
        "\n",
        "print(\"Initial State:\\n\" + str(initial_state))\n",
        "print(\"\\nGoal State:\\n\" + str(goal_state))\n",
        "\n",
        "print(\"\\nSearching for solution...\")\n",
        "solution_state = iddls(initial_state, goal_state)\n",
        "\n",
        "if solution_state:\n",
        "    print(f\"\\nSolution Found at depth: {solution_state.depth}\")\n",
        "    path = []\n",
        "    current = solution_state\n",
        "    while current:\n",
        "        path.append(current)\n",
        "        current = current.parent\n",
        "\n",
        "    path.reverse() # Reconstruct path from start to goal\n",
        "\n",
        "    print(\"\\nSolution Path:\")\n",
        "    for i, state in enumerate(path):\n",
        "        if state.move:\n",
        "            print(f\"Step {i}: Move {state.move}\")\n",
        "        else:\n",
        "            print(f\"Step {i}: Initial State\")\n",
        "        print(str(state))\n",
        "        print(\"\\n\")\n",
        "else:\n",
        "    print(\"\\nNo solution found within the specified maximum depth.\")\n"
      ],
