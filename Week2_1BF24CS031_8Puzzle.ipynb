      "source": [
        "import copy\n",
        "\n",
        "class PuzzleState:\n",
        "    def __init__(self, board, parent=None, move=None, depth=0):\n",
        "        self.board = board  # 3x3 list of lists\n",
        "        self.parent = parent # Previous state\n",
        "        self.move = move    # Move that led to this state\n",
        "        self.depth = depth  # Depth of this state in the search tree\n",
        "        self.g_cost = depth # Cost from start node to current node\n",
        "\n",
        "    def __eq__(self, other):\n",
        "        return self.board == other.board\n",
        "\n",
        "    def __hash__(self):\n",
        "        return hash(str(self.board))\n",
        "\n",
        "    def __str__(self):\n",
        "        return '\\n'.join([' '.join(map(str, row)) for row in self.board])\n",
        "\n",
        "    def get_blank_position(self):\n",
        "        for r in range(3):\n",
        "            for c in range(3):\n",
        "                if self.board[r][c] == 0:\n",
        "                    return r, c\n",
        "        return None\n",
        "\n",
        "    def get_possible_moves(self):\n",
        "        r_blank, c_blank = self.get_blank_position()\n",
        "        moves = []\n",
        "        # Define possible directions: (dr, dc)\n",
        "        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n",
        "\n",
        "        for dr, dc in directions:\n",
        "            new_r, new_c = r_blank + dr, c_blank + dc\n",
        "            if 0 <= new_r < 3 and 0 <= new_c < 3:\n",
        "                moves.append((new_r, new_c)) # This is the position to swap with blank\n",
        "        return moves\n",
        "\n",
        "    def apply_move(self, target_pos):\n",
        "        r_blank, c_blank = self.get_blank_position()\n",
        "        r_target, c_target = target_pos\n",
        "\n",
        "        new_board = copy.deepcopy(self.board)\n",
        "        new_board[r_blank][c_blank] = new_board[r_target][c_target]\n",
        "        new_board[r_target][c_target] = 0\n",
        "\n",
        "        move_name = ''\n",
        "        if r_target < r_blank: move_name = 'Up'\n",
        "        elif r_target > r_blank: move_name = 'Down'\n",
        "        elif c_target < c_blank: move_name = 'Left'\n",
        "        elif c_target > c_blank: move_name = 'Right'\n",
        "\n",
        "        return PuzzleState(new_board, parent=self, move=move_name, depth=self.depth + 1)\n"
      ],
      "execution_count": 2,
      "outputs": []
    },
